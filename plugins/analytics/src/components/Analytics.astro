---
// Componente de Analytics para Astro
---
<script is:inline>
  // Google Analytics
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', import.meta.env.PUBLIC_GA_ID);
</script>
<script 
  is:inline 
  async 
  src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}
></script>
