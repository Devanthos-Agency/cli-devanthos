{
    "name": "@devanthos/plugin-analytics",
    "version": "1.0.0",
    "description": "Integración de Google Analytics y Vercel Analytics",
    "author": "Devanthos",
    "license": "MIT",
    "frameworks": ["astro", "next"],
    "dependencies": {
        "astro": [],
        "next": ["@vercel/analytics"]
    },
    "envVars": {
        "astro": ["PUBLIC_GA_ID"],
        "next": ["NEXT_PUBLIC_GA_ID"]
    },
    "files": {
        "astro": [
            {
                "source": "src/components/Analytics.astro",
                "destination": "src/components/Analytics.astro"
            }
        ],
        "next": [
            {
                "source": "src/components/Analytics.tsx",
                "destination": "components/Analytics.tsx"
            },
            {
                "source": "src/lib/analytics.ts",
                "destination": "lib/analytics.ts"
            }
        ]
    }
}
