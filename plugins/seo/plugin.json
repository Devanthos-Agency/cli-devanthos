{
    "name": "@devanthos/plugin-seo",
    "version": "1.0.0",
    "description": "Plugin para optimización SEO (meta tags, sitemap, robots.txt, OpenGraph)",
    "author": "Devanthos",
    "license": "MIT",
    "frameworks": ["astro", "next"],
    "dependencies": {
        "astro": {
            "@astrojs/sitemap": "^3.0.0",
            "@astrojs/rss": "^4.0.0"
        },
        "next": {
            "next-seo": "^6.5.0",
            "next-sitemap": "^4.2.3"
        }
    },
    "envVars": ["SITE_URL"],
    "files": [
        {
            "framework": "astro",
            "source": "src/components/SEO.astro",
            "destination": "src/components/SEO.astro"
        },
        {
            "framework": "astro",
            "source": "src/config/robots.txt",
            "destination": "public/robots.txt"
        },
        {
            "framework": "next",
            "source": "src/components/SEO.tsx",
            "destination": "components/SEO.tsx"
        },
        {
            "framework": "next",
            "source": "src/config/next-sitemap.config.js",
            "destination": "next-sitemap.config.js"
        }
    ],
    "postInstall": {
        "message": "🔍 SEO configurado. Actualiza la URL del sitio en las configuraciones.",
        "instructions": [
            "1. Configura SITE_URL en tu archivo .env",
            "2. Para Next.js: agrega script 'postbuild': 'next-sitemap' en package.json",
            "3. Importa y usa el componente SEO en tus páginas",
            "4. Personaliza los meta tags según tu proyecto"
        ]
    }
}
