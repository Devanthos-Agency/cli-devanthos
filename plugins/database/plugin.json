{
    "name": "@devanthos/plugin-database",
    "version": "1.0.0",
    "description": "Plugin para integración de base de datos con Prisma ORM",
    "author": "Devanthos",
    "license": "MIT",
    "frameworks": ["next", "astro"],
    "dependencies": {
        "next": {
            "@prisma/client": "^5.7.0"
        },
        "astro": {
            "@prisma/client": "^5.7.0"
        }
    },
    "devDependencies": {
        "next": {
            "prisma": "^5.7.0"
        },
        "astro": {
            "prisma": "^5.7.0"
        }
    },
    "envVars": ["DATABASE_URL"],
    "files": [
        {
            "framework": "next",
            "source": "src/prisma/schema.prisma",
            "destination": "prisma/schema.prisma"
        },
        {
            "framework": "next",
            "source": "src/lib/prisma.ts",
            "destination": "lib/prisma.ts"
        },
        {
            "framework": "astro",
            "source": "src/prisma/schema.prisma",
            "destination": "prisma/schema.prisma"
        },
        {
            "framework": "astro",
            "source": "src/lib/prisma.ts",
            "destination": "lib/prisma.ts"
        }
    ],
    "postInstall": {
        "message": "💾 Prisma configurado.",
        "instructions": [
            "1. Configura DATABASE_URL en tu archivo .env",
            "   Ejemplos:",
            "   - PostgreSQL: postgresql://user:password@localhost:5432/dbname",
            "   - MySQL: mysql://user:password@localhost:3306/dbname",
            "   - SQLite: file:./dev.db",
            "",
            "2. Ejecuta: npx prisma generate",
            "3. Ejecuta: npx prisma db push",
            "4. (Opcional) Ejecuta: npx prisma studio para explorar la base de datos",
            "",
            "5. Personaliza el schema.prisma según tus necesidades"
        ]
    }
}
