{
    "name": "@devanthos/plugin-stripe",
    "version": "1.0.0",
    "description": "Integración completa de pagos con Stripe",
    "author": "Devanthos",
    "license": "MIT",
    "frameworks": ["next"],
    "dependencies": {
        "stripe": "^14.0.0",
        "@stripe/stripe-js": "^2.4.0",
        "@stripe/react-stripe-js": "^2.4.0"
    },
    "envVars": ["STRIPE_SECRET_KEY", "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY", "STRIPE_WEBHOOK_SECRET"],
    "files": [
        {
            "source": "src/lib/stripe.ts",
            "destination": "lib/stripe.ts"
        },
        {
            "source": "src/app/api/checkout/route.ts",
            "destination": "app/api/checkout/route.ts"
        },
        {
            "source": "src/app/api/webhook/route.ts",
            "destination": "app/api/webhook/route.ts"
        },
        {
            "source": "src/components/CheckoutButton.tsx",
            "destination": "components/CheckoutButton.tsx"
        }
    ]
}
