{
    "name": "create-devanthos-app",
    "version": "2.2.1",
    "type": "module",
    "description": "CLI oficial para crear proyectos con las plantillas modernas Devanthos (Astro, Next.js, Expo y más) - Con sistema de plugins, actualizaciones automáticas, CLI flags, Git auto-init, presets y configuración personalizable. Versión 2.0: Plantillas locales y sistema de extras.",
    "homepage": "https://devanthos.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/devanthos/create-devanthos-app.git"
    },
    "bugs": {
        "url": "https://github.com/devanthos/create-devanthos-app/issues"
    },
    "main": "./src/index.js",
    "exports": {
        ".": {
            "default": "./src/index.js"
        }
    },
    "bin": {
        "create-devanthos-app": "./src/index.js"
    },
    "files": [
        "src/",
        "templates/",
        "README.md"
    ],
    "keywords": [
        "cli",
        "devanthos",
        "create-app",
        "astro",
        "nextjs",
        "expo",
        "react-native",
        "mobile",
        "template",
        "starter",
        "boilerplate",
        "scaffold",
        "generator",
        "frontend",
        "web-development",
        "mobile-development",
        "plugins",
        "extensible",
        "auto-update",
        "dependency-update",
        "local-templates"
    ],
    "author": {
        "name": "Devanthos",
        "url": "https://devanthos.com"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "chalk": "^6.0.1",
        "commander": "^15.0.0",
        "inquirer": "^14.2.3",
        "ora": "^9.4.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "eslint": "^8.57.0",
        "prettier": "^3.9.9",
        "vitest": "^5.0.3"
    },
    "scripts": {
        "test": "vitest",
        "test:run": "vitest run",
        "lint": "eslint src/",
        "format": "prettier --write src/",
        "dev": "node src/index.js",
        "prepublishOnly": "npm run test:run && npm run lint"
    }
}
